# Copy these settings into .env. Do not commit the actual token.
# Set true on only one API instance; false on all others. Default: false.
GITHUB_ARCHIVE_ENABLED=false
GITHUB_ARCHIVE_TOKEN=
GITHUB_ARCHIVE_REPOSITORY=BooyahDev/BoopsDB-Archive
# Empty uses the repository default branch (also initializes an empty repository).
GITHUB_ARCHIVE_BRANCH=
# Persist this directory on a volume when running in Docker/Kubernetes.
GITHUB_ARCHIVE_DIR=.boops-archive

# Notion is enabled independently from GitHub. Enable on only one API instance.
NOTION_ARCHIVE_ENABLED=false
NOTION_ARCHIVE_TOKEN=
# Database ID (the variable name is retained for compatibility).
NOTION_ARCHIVE_PAGE_ID=3f1f663606fc8061a287f4838ff648c3
NOTION_ARCHIVE_DIR=.boops-archive/notion
